{
  "name": "Customer",
  "properties": {
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "company_name": {
      "description": "Firmenname des Kunden",
      "type": "string"
    },
    "contact_person": {
      "description": "Ansprechpartner",
      "type": "string"
    },
    "country": {
      "default": "Deutschland",
      "type": "string"
    },
    "customer_number": {
      "type": "string"
    },
    "email": {
      "format": "email",
      "type": "string"
    },
    "last_order_date": {
      "format": "date",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "status": {
      "default": "aktiv",
      "enum": [
        "aktiv",
        "inaktiv",
        "potentiell"
      ],
      "type": "string"
    },
    "total_revenue": {
      "description": "Gesamtumsatz",
      "type": "number"
    }
  },
  "required": [
    "company_name",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "partner"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}