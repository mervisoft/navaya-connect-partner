{
  "name": "Product",
  "properties": {
    "availability": {
      "default": "Auf Lager",
      "enum": [
        "Auf Lager",
        "2-3 Tage",
        "1-2 Wochen",
        "Auf Anfrage"
      ],
      "type": "string"
    },
    "category": {
      "description": "Hauptkategorie",
      "enum": [
        "Software",
        "Hardware",
        "Lizenzen",
        "Services",
        "Zubeh\u00f6r"
      ],
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "image_url": {
      "type": "string"
    },
    "list_price": {
      "description": "Listenpreis (UVP)",
      "type": "number"
    },
    "manufacturer": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "product_line": {
      "description": "Produktlinie / Hersteller-Produkt (z.B. BricsCAD, AutoCAD, Windows)",
      "type": "string"
    },
    "product_number": {
      "type": "string"
    },
    "stock": {
      "default": 0,
      "type": "number"
    },
    "subcategory": {
      "description": "Lizenztyp / Unterkategorie",
      "enum": [
        "Vollizenz",
        "Upgrade",
        "Wartung",
        "Mietlizenz",
        "Add-on",
        "Bundle",
        "Sonstiges"
      ],
      "type": "string"
    },
    "upgrade_from_version": {
      "description": "Upgrade von Version (z.B. V22, V23) \u2013 nur f\u00fcr Upgrade-Produkte",
      "type": "string"
    },
    "upgrade_to_version": {
      "description": "Upgrade auf Version (z.B. V25) \u2013 nur f\u00fcr Upgrade-Produkte",
      "type": "string"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "partner"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}