{
  "name": "Order",
  "properties": {
    "amount": {
      "type": "number"
    },
    "file_url": {
      "type": "string"
    },
    "items": {
      "items": {
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "order_date": {
      "format": "date",
      "type": "string"
    },
    "order_number": {
      "description": "Auftragsnummer",
      "type": "string"
    },
    "status": {
      "default": "neu",
      "enum": [
        "neu",
        "in_bearbeitung",
        "versendet",
        "abgeschlossen",
        "storniert"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "order_number",
    "title",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "partner"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}