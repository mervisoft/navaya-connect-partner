{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Auftragsnummer"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "neu",
        "in_bearbeitung",
        "versendet",
        "abgeschlossen",
        "storniert"
      ],
      "default": "neu"
    },
    "amount": {
      "type": "number"
    },
    "order_date": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "file_url": {
      "type": "string"
    }
  },
  "required": [
    "order_number",
    "title",
    "amount"
  ]
}