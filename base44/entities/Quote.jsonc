{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "description": "Angebotsnummer"
    },
    "title": {
      "type": "string",
      "description": "Angebotstitel"
    },
    "status": {
      "type": "string",
      "enum": [
        "offen",
        "angenommen",
        "abgelehnt",
        "abgelaufen"
      ],
      "default": "offen"
    },
    "amount": {
      "type": "number",
      "description": "Gesamtbetrag"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "is_customer_comment": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "quote_number",
    "title",
    "amount"
  ]
}