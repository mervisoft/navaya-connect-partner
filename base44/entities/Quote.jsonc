{
  "name": "Quote",
  "properties": {
    "amount": {
      "description": "Gesamtbetrag",
      "type": "number"
    },
    "comments": {
      "items": {
        "properties": {
          "author": {
            "type": "string"
          },
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "is_customer_comment": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "file_url": {
      "type": "string"
    },
    "items": {
      "items": {
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "type": "string"
    },
    "quote_number": {
      "description": "Angebotsnummer",
      "type": "string"
    },
    "status": {
      "default": "offen",
      "enum": [
        "offen",
        "angenommen",
        "abgelehnt",
        "abgelaufen"
      ],
      "type": "string"
    },
    "title": {
      "description": "Angebotstitel",
      "type": "string"
    },
    "valid_until": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "quote_number",
    "title",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "partner"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}