{
  "name": "Project",
  "type": "object",
  "properties": {
    "project_number": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "geplant",
        "aktiv",
        "pausiert",
        "abgeschlossen"
      ],
      "default": "geplant"
    },
    "progress": {
      "type": "number",
      "description": "Fortschritt in Prozent (0-100)"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}