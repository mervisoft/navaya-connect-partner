{
  "name": "Project",
  "properties": {
    "description": {
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "progress": {
      "description": "Fortschritt in Prozent (0-100)",
      "type": "number"
    },
    "project_number": {
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "geplant",
      "enum": [
        "geplant",
        "aktiv",
        "pausiert",
        "abgeschlossen"
      ],
      "type": "string"
    },
    "tasks": {
      "items": {
        "properties": {
          "due_date": {
            "format": "date",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}