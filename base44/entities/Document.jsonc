{
  "name": "Document",
  "properties": {
    "category": {
      "default": "sonstiges",
      "enum": [
        "vertrag",
        "agb",
        "preisliste",
        "handbuch",
        "sonstiges"
      ],
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_size": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "partner"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}