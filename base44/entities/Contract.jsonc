{
  "name": "Contract",
  "properties": {
    "auto_renew": {
      "default": true,
      "type": "boolean"
    },
    "billing_cycle": {
      "default": "monatlich",
      "enum": [
        "monatlich",
        "viertelj\u00e4hrlich",
        "j\u00e4hrlich"
      ],
      "type": "string"
    },
    "contract_number": {
      "type": "string"
    },
    "edition": {
      "description": "Edition (z.B. Pro, BIM, Lite)",
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "monthly_amount": {
      "type": "number"
    },
    "product_line": {
      "description": "Produktlinie (z.B. BricsCAD)",
      "type": "string"
    },
    "seats": {
      "description": "Anzahl Lizenzen/Seats",
      "type": "number"
    },
    "serial_numbers": {
      "description": "Seriennummern der Lizenzen",
      "items": {
        "properties": {
          "seat_name": {
            "type": "string"
          },
          "serial": {
            "type": "string"
          },
          "status": {
            "default": "aktiv",
            "enum": [
              "aktiv",
              "gesperrt",
              "abgelaufen"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "aktiv",
      "enum": [
        "aktiv",
        "gek\u00fcndigt",
        "ausgelaufen",
        "entwurf"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "contract_number",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}