{
  "name": "DeliveryNote",
  "properties": {
    "carrier": {
      "type": "string"
    },
    "delivery_number": {
      "description": "Lieferscheinnummer",
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "items": {
      "items": {
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "order_number": {
      "type": "string"
    },
    "shipping_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "in_vorbereitung",
      "enum": [
        "in_vorbereitung",
        "versendet",
        "zugestellt"
      ],
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    }
  },
  "required": [
    "delivery_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}